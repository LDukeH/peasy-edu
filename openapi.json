            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Đã xóa môn học"
          },
          "401": {
            "description": "Chưa đăng nhập hoặc access token hết hạn",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "Không phải vai trò QUAN_LY",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy môn học",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "Môn đã được sử dụng, chỉ có thể ngừng sử dụng",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Xóa môn học",
        "tags": [
          "Subjects"
        ]
      }
    }
  },
  "info": {
    "title": "Peasy Edu API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "access_token"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "default": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "tenDangNhap": {
            "type": "string",
            "maxLength": 50,
            "description": "Tên đăng nhập; phụ huynh dùng số điện thoại",
            "example": "0901234567"
          },
          "matKhau": {
            "type": "string",
            "maxLength": 72,
            "example": "MatKhau@123"
          }
        },
        "required": [
          "tenDangNhap",
          "matKhau"
        ]
      },
      "VaiTro": {
        "type": "string",
        "enum": [
          "QUAN_LY",
          "DIEU_PHOI",
          "GIA_SU",
          "PHU_HUYNH"
        ]
      },
      "TrangThaiTaiKhoan": {
        "type": "string",
        "enum": [
          "HOAT_DONG",
          "BI_KHOA"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Khóa kỹ thuật (không hiển thị cho người dùng)",
            "example": 1
          },
          "tenDangNhap": {
            "type": "string",
            "description": "Tên đăng nhập, duy nhất. Phụ huynh dùng số điện thoại",
            "example": "0901234567"
          },
          "hoTen": {
            "type": "string",
            "example": "Nguyễn Văn An"
          },
          "email": {
            "type": "string",
            "nullable": true,
            "example": "an.nguyen@example.com"
          },
          "soDienThoai": {
            "type": "string",
            "nullable": true,
            "example": "0901234567"
          },
          "vaiTro": {
            "example": "PHU_HUYNH",
            "allOf": [
              {
                "$ref": "#/components/schemas/VaiTro"
              }
            ]
          },
          "trangThai": {
            "example": "HOAT_DONG",
            "allOf": [
              {
                "$ref": "#/components/schemas/TrangThaiTaiKhoan"
              }
            ]
          },
          "maDoiTuong": {
            "type": "string",
            "nullable": true,
            "description": "Mã nghiệp vụ của đối tượng liên kết (PHxxxxx, GSxxxxx, NVxxx); null nếu chưa liên kết",
            "example": "PH00015"
          },
          "lanDangNhapCuoi": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "example": "2026-11-17T08:30:00.000Z"
          },
          "ngayTao": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-16T02:00:00.000Z"
          }
        },
        "required": [
          "id",
          "tenDangNhap",
          "hoTen",
          "email",
          "soDienThoai",
          "vaiTro",
          "trangThai",
          "maDoiTuong",
          "lanDangNhapCuoi",
          "ngayTao"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer",
            "example": 400
          },
          "message": {
            "description": "Thông báo lỗi; lỗi validate (400) trả về mảng, các lỗi khác trả về chuỗi",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": [
              "soDienThoai phải gồm 10 chữ số, bắt đầu bằng 0"
            ]
          },
          "error": {
            "type": "string",
            "example": "Bad Request"
          }
        },
        "required": [
          "statusCode",
          "message",
          "error"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "hoTen": {
            "type": "string",
            "maxLength": 100,
            "example": "Nguyễn Văn An"
          },
          "soDienThoai": {
            "type": "string",
            "pattern": "^0\\d{9}$",
            "description": "Số điện thoại Việt Nam (10 chữ số, bắt đầu bằng 0), dùng làm tên đăng nhập",
            "example": "0901234567"
          },
          "matKhau": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72,
            "description": "Mật khẩu 8–72 ký tự (giới hạn của bcrypt)",
            "example": "MatKhau@123"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "an.nguyen@example.com"
          }
        },
        "required": [
          "hoTen",
          "soDienThoai",
          "matKhau"
        ]
      },
      "UserListResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserDto"
            }
          },
          "total": {
            "type": "integer",
            "description": "Tổng số bản ghi khớp bộ lọc",
            "example": 42
          },
          "page": {
            "type": "integer",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "example": 20
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "pageSize"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "tenDangNhap": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50,
            "pattern": "^[a-zA-Z0-9._@-]+$",
            "description": "Tên đăng nhập, duy nhất: chữ, số và . _ @ -",
            "example": "dieuphoi01"
          },
          "matKhau": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72,
            "description": "Mật khẩu ban đầu, 8–72 ký tự (giới hạn của bcrypt)",
            "example": "MatKhau@123"
          },
          "hoTen": {
            "type": "string",
            "maxLength": 100,
            "example": "Trần Thị Bình"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "binh.tran@example.com"
          },
          "soDienThoai": {
            "type": "string",
            "pattern": "^0\\d{9}$",
            "description": "Số điện thoại Việt Nam: 10 chữ số, bắt đầu bằng 0",
            "example": "0912345678"
          },
          "vaiTro": {
            "example": "DIEU_PHOI",
            "allOf": [
              {
                "$ref": "#/components/schemas/VaiTro"
              }
            ]
          }
        },
        "required": [
          "tenDangNhap",
          "matKhau",
          "hoTen",
          "vaiTro"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "matKhau": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72,
            "description": "Mật khẩu ban đầu, 8–72 ký tự (giới hạn của bcrypt)",
            "example": "MatKhau@123"
          },
          "hoTen": {
            "type": "string",
            "maxLength": 100,
            "example": "Trần Thị Bình"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "binh.tran@example.com"
          },
          "soDienThoai": {
            "type": "string",
            "pattern": "^0\\d{9}$",
            "description": "Số điện thoại Việt Nam: 10 chữ số, bắt đầu bằng 0",
            "example": "0912345678"
          },
          "vaiTro": {
            "example": "DIEU_PHOI",
            "allOf": [
              {
                "$ref": "#/components/schemas/VaiTro"
              }
            ]
          },
          "trangThai": {
            "example": "BI_KHOA",
            "allOf": [
              {
                "$ref": "#/components/schemas/TrangThaiTaiKhoan"
              }
            ]
          }
        }
      },
      "NhomMon": {
        "type": "string",
        "enum": [
          "VAN_HOA",
          "NGOAI_NGU",
          "NANG_KHIEU_KY_NANG",
          "LUYEN_THI"
        ]
      },
      "CapHoc": {
        "type": "string",
        "enum": [
          "TIEU_HOC",
          "THCS",
          "THPT",
          "DAI_HOC",
          "NGUOI_DI_LAM"
        ]
      },
      "TrangThaiMonHoc": {
        "type": "string",
        "enum": [
          "DANG_SU_DUNG",
          "NGUNG_SU_DUNG"
        ]
      },
      "SubjectDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Khóa kỹ thuật (không hiển thị cho người dùng)",
            "example": 1
          },
          "ma": {
            "type": "string",
            "description": "Mã môn do hệ thống sinh, dạng MHxx",
            "example": "MH01"
          },
          "tenMon": {
            "type": "string",
            "example": "Toán"
          },
          "nhomMon": {
            "example": "VAN_HOA",
            "allOf": [
              {
                "$ref": "#/components/schemas/NhomMon"
              }
            ]
          },
          "capHoc": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CapHoc"
            },
            "example": [
              "THCS",
              "THPT"
            ]
          },
          "moTa": {
            "type": "string",
            "nullable": true,
            "example": "Toán chương trình phổ thông 2018"
          },
          "trangThai": {
            "example": "DANG_SU_DUNG",
            "allOf": [
              {
                "$ref": "#/components/schemas/TrangThaiMonHoc"
              }
            ]
          }
        },
        "required": [
          "id",
          "ma",
          "tenMon",
          "nhomMon",
          "capHoc",
          "moTa",
          "trangThai"
        ]
      },
      "CreateSubjectDto": {
        "type": "object",
        "properties": {
          "tenMon": {
            "type": "string",
            "maxLength": 100,
            "description": "Tên môn, duy nhất",
            "example": "Toán"
          },
          "nhomMon": {
            "example": "VAN_HOA",
            "allOf": [
              {
                "$ref": "#/components/schemas/NhomMon"
              }
            ]
          },
          "capHoc": {
            "minItems": 1,
            "uniqueItems": true,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CapHoc"
            },
            "description": "Cấp học áp dụng, ít nhất 1. TIEU_HOC chỉ hợp lệ với nhóm NANG_KHIEU_KY_NANG (TT 29/2024)",
            "example": [
              "THCS",
              "THPT"
            ]
          },
          "moTa": {
            "type": "string",
            "maxLength": 500,
            "example": "Toán chương trình phổ thông 2018"
          }
        },
        "required": [
          "tenMon",
          "nhomMon",
          "capHoc"
        ]
      },
      "UpdateSubjectDto": {
        "type": "object",
        "properties": {
          "tenMon": {
            "type": "string",
            "maxLength": 100,
            "description": "Tên môn, duy nhất",
            "example": "Toán"
          },
          "nhomMon": {
            "example": "VAN_HOA",
            "allOf": [
              {
                "$ref": "#/components/schemas/NhomMon"
              }
            ]
          },
          "capHoc": {
            "minItems": 1,
            "uniqueItems": true,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CapHoc"
            },
            "description": "Cấp học áp dụng, ít nhất 1. TIEU_HOC chỉ hợp lệ với nhóm NANG_KHIEU_KY_NANG (TT 29/2024)",
            "example": [
              "THCS",
              "THPT"
            ]
          },
          "moTa": {
            "type": "string",
            "maxLength": 500,
            "example": "Toán chương trình phổ thông 2018"
          },
          "trangThai": {
            "description": "Ngừng sử dụng thay cho xóa khi môn đã có lớp",
            "example": "NGUNG_SU_DUNG",
            "allOf": [
              {
                "$ref": "#/components/schemas/TrangThaiMonHoc"
              }
            ]
          }
        }
      }
    }
  }
}
