PORT=4000
FRONTEND_URL=http://localhost:3000

# Lấy từ Supabase -> Connect -> ORMs -> Prisma
# Port 6543 (Transaction Pooler) cho truy vấn ứng dụng
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Port 5432 (Session Pooler) dùng khi chạy prisma migrate
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"

# Mật khẩu của tài khoản mẫu khi chạy db:seed; để trống thì không tạo tài khoản mẫu
SEED_MAT_KHAU_MAU=""