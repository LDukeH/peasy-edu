PORT=4000
FRONTEND_URL=http://localhost:3000

# Lấy từ Supabase -> Connect -> ORMs -> Prisma
# Port 6543 (Transaction Pooler) cho truy vấn ứng dụng
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Port 5432 (Session Pooler) dùng khi chạy prisma migrate
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"

# Mật khẩu của tài khoản mẫu khi chạy db:seed; để trống thì không tạo tài khoản mẫu
SEED_MAT_KHAU_MAU="123456789"

# Khóa mã hóa CCCD và số tài khoản ngân hàng (AES-256-GCM) và khóa HMAC để bắt trùng CCCD.
# Mỗi khóa là base64 của 32 byte, hai khóa phải khác nhau. Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# DB Supabase dùng chung -> cả nhóm (và Render nếu trỏ cùng DB) phải dùng CÙNG một cặp khóa: xin Duy, không commit.
# Mất hoặc đổi khóa = không đọc lại được CCCD/STK đã lưu. Để trống: API hồ sơ gia sư trả 500, seed bỏ qua gia sư mẫu.
DATA_ENCRYPTION_KEY=
DATA_HMAC_KEY=

# Supabase Storage (bucket private cho ảnh CCCD, chân dung, giấy tờ năng lực).
# Cần tạo sẵn bucket `peasy-private` (tắt Public bucket) trên Supabase Dashboard -> Storage trước khi chạy.
# Lấy Project URL (Connect) & Secret key dạng sb_secret_... (Project Settings -> API Keys); KHÔNG commit key thật.
# Để trống: API /storage/* trả 500, các API khác vẫn khởi động bình thường.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET="peasy-private"
